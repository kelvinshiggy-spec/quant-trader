# ---- quant-trader configuration (copy to .env; NEVER commit .env) ----
# Trading mode: paper only. Live requires LIVE_TRADING_ENABLED=true, the exact confirmation
# phrase, and SEPARATE live keys. Anything ambiguous makes the system refuse to start.
TRADING_MODE=paper
ALPACA_PAPER_API_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_PAPER_API_SECRET=replace-me
# ALPACA_LIVE_API_KEY=            (leave empty; requires separate written authorization)
# ALPACA_LIVE_API_SECRET=
# LIVE_TRADING_ENABLED=false
# LIVE_TRADING_CONFIRMATION=

# Account model for the internal $100 ledger: cash (settled funds only, T+1) or margin_1x
ACCOUNT_TYPE=cash
ALPACA_DATA_FEED=iex
ALPACA_RESEARCH_FEED=sip
QT_DATA_DIR=/app/data

# Approved risk ceiling (dashboard can only tighten below this). JSON; omit to use the spec defaults.
# QT_RISK_CEILING_JSON={"risk_per_trade_pct":0.5,"max_daily_loss_pct":2,"max_weekly_loss_pct":5,"max_drawdown_pct":10,"max_positions":2,"max_position_alloc_pct":50,"max_total_alloc_pct":80}

# Execution switches that need separate approval (keep false until validated + approved)
ALLOW_CRYPTO_EXECUTION=false
ALLOW_OVERNIGHT_HOLDS=false
# true = a strategy that passes every pre-registered validation check is approved for PAPER orders
# automatically (owner opt-in). It is suspended again automatically if a later run or forward test fails it.
AUTO_APPROVE_VALIDATED=false

# Dashboard
DASHBOARD_DOMAIN=example.sslip.io
DASHBOARD_USER=admin
# bcrypt hash: python -m scripts.hash_password   (never store the plain password)
DASHBOARD_PASSWORD_HASH=$2b$12$replace.with.a.real.bcrypt.hash
# 64 random hex chars: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-64-random-hex-characters

# Notifications (optional): all | important | daily | off
NOTIFY_LEVEL=important
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Research container
RESEARCH_WORKERS=1
RESEARCH_MEM_LIMIT=900m
